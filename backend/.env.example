NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Neon pooled URL for application traffic. Use a direct URL for migrations.
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Use a cryptographically random value with at least 32 characters.
SESSION_SECRET=

# Gmail SMTP (dedicated account + Google App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Base URL used in email verification and recovery links.
PUBLIC_APP_URL=http://localhost:5173
