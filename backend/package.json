{
  "name": "ecopunto-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --require ./scripts/node-compat.cjs --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-seed-data.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --require ./scripts/node-compat.cjs --import tsx --test",
    "db:generate": "node --require ./scripts/node-compat.cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --require ./scripts/node-compat.cjs --env-file-if-exists=.env --import tsx src/scripts/migrate.ts",
    "db:seed": "node --require ./scripts/node-compat.cjs --env-file-if-exists=.env --import tsx src/scripts/seed.ts",
    "admin:promote": "node --require ./scripts/node-compat.cjs --env-file-if-exists=.env --import tsx src/scripts/promote-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.44.7",
    "dotenv": "^16.4.7",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.0.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "argon2@0.44.0": true
  }
}
